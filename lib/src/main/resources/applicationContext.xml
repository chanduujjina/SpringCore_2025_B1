<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:context="http://www.springframework.org/schema/context"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
        http://www.springframework.org/schema/beans 
        http://www.springframework.org/schema/beans/spring-beans.xsd
        http://www.springframework.org/schema/context 
        http://www.springframework.org/schema/context/spring-context.xsd">
        
        
       <import resource="annationconfig.xml"/>
       
       <context:property-placeholder location="classpath:test.properties"/>
       
       <bean name = "appconfig" class = "com.demo.coolcoder.di.xml.Appconfig">
		 <property name="appName" value = "${appName}"/>
		  <property name="version" value = "${version}"/>
	   </bean>
        
         <bean name = "helloWord" class = "com.demo.coolcoder.Helloworld">
		<property name="name" value="chandu"/>
         </bean>
         
        <bean name = "customerService" class = "com.demo.coolcoder.CustomerService" init-method="customInit" destroy-method="customDestroy"/>
         
         <bean name = "dm1" class = "com.demo.coolcoder.di.xml.Demo1" autowire="no">
			 <property name="demo2" ref="dm2"/>
         </bean>
         <bean name = "dm2" class = "com.demo.coolcoder.di.xml.Demo2"/>
         
         
          <bean name = "dm3" class = "com.demo.coolcoder.di.xml.Demo3" autowire="byType"/>
          <bean name = "dm4" class = "com.demo.coolcoder.di.xml.Demo4" />
          
          
          <bean name = "dm5" class = "com.demo.coolcoder.di.xml.Demo5" autowire="byName"/>
          <bean name = "dm6_v1" class = "com.demo.coolcoder.di.xml.Demo6" />
          <bean name = "dm6_v2" class = "com.demo.coolcoder.di.xml.Demo6" />
          
           <bean name = "dm7" class = "com.demo.coolcoder.di.xml.Demo7" autowire="constructor"/>
           <bean name = "dm8" class = "com.demo.coolcoder.di.xml.Demo8" />
           
            <bean name = "baseEmployee" class = "com.demo.coolcoder.di.xml.BaseEmployee"/>
            
            <bean name = "contract" class = "com.demo.coolcoder.di.xml.ContractEmployee" parent="baseEmployee"/>
            
             <bean name = "permemnent" class = "com.demo.coolcoder.di.xml.PermemnentEmployee" parent="baseEmployee"/>
             
             
              <bean name = "dm9" class = "com.demo.coolcoder.di.xml.Demo9" autowire="byType" >
				  <property name="baseDemo" ref="dm11"></property>
              </bean>
              <bean name = "dm10" class = "com.demo.coolcoder.di.xml.Demo10" />
              <bean name = "dm11" class = "com.demo.coolcoder.di.xml.Demo11" />
              
            
</beans>